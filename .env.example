# Demo only. Keep live consumer data outside this build.
HELM_DATABASE_URL=sqlite:///.runtime/broker.db
HELM_AGENT_RUNTIME=python
HELM_ALLOWED_ORIGIN=http://127.0.0.1:5180
HELM_COOKIE_SECURE=false
# Local RSA signer is created in .runtime/auth-signing.pem; preserve it with the key backup.
# Live deployments supply HELM_JWT_PRIVATE_KEY from an approved secret manager.
HELM_IPT_RATE=0.12
HELM_DEMO_CLOCK_MULTIPLIER=3600
# Six business hours become six real seconds; security expiry stays in real UTC.
HELM_PARTNER_MODE=simulator
# Set http_simulator to exercise the separate five-partner service on port 8013.
HELM_PARTNER_SIMULATOR_URL=http://127.0.0.1:8013
HELM_LLM_DAILY_TOKEN_BUDGET=1000000
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# HELM_ENCRYPTION_KEY=
# PostgreSQL/Redis alternative (docker compose up -d postgres redis):
# HELM_DATABASE_URL=postgresql+psycopg://helm:helm_local_demo_only@127.0.0.1:55439/helm_broker
# HELM_REDIS_URL=redis://127.0.0.1:56389/0
